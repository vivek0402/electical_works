# Copy to .env and fill in. Never commit .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Prod only: https://your-domain
CSRF_TRUSTED_ORIGINS=

# Database (compose sets this for the web container; this value is for running on the host)
DATABASE_URL=postgres://svkml:svkml@localhost:5433/svkml

# Initial password for users created by `manage.py seed_demo`
SEED_PASSWORD=change-me

LOG_LEVEL=INFO
